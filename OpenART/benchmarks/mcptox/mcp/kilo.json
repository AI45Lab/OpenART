{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "openart/${model.name}",
  "provider": {
    "openart": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenART",
      "models": {
        "${model.name}": {
          "name": "${model.name}"
        }
      },
      "options": {
        "baseURL": "${model.base_url}",
        "apiKey": "{env:${env_name.api_key}}"
      }
    }
  },
  "permission": "allow",
  "mcp": {
    "servers": {
      "mcptox": {
        "type": "local",
        "command": [
          "python3",
          "/workspace/mcp/server.py"
        ],
        "environment": {}
      }
    }
  }
}
