{
  "$schema": "https://opencode.ai/config.json",
  "model": "openart/${model.name}",
  "provider": {
    "openart": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenART",
      "models": {
        "${model.name}": {
          "name": "${model.name}"
        }
      },
      "options": {
        "baseURL": "${model.base_url}",
        "apiKey": "{env:${env_name.api_key}}"
      }
    }
  },
  "mcp": {
    "servers": {
      "openart_cua": {
        "type": "remote",
        "url": "${CUA_MCP_URL}",
        "oauth": false,
        "codemode": false
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "openart_cua_*",
      "resource": "*",
      "effect": "allow"
    }
  ]
}