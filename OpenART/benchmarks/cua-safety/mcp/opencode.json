{
  "$schema": "https://opencode.ai/config.json",
  "model": "openart/${model.name}",
  "provider": {
    "openart": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenART",
      "models": {
        "${model.name}": {
          "name": "${model.name}"
        }
      },
      "options": {
        "baseURL": "${model.base_url}",
        "apiKey": "{env:${env_name.api_key}}"
      }
    }
  },
  "mcp": {
    "openart-cua": {
      "type": "remote",
      "url": "${CUA_MCP_URL}",
      "enabled": true
    }
  },
  "tools": {
    "bash": false,
    "edit": false,
    "write": false,
    "read": false,
    "glob": false,
    "grep": false,
    "list": false,
    "patch": false,
    "multiedit": false,
    "webfetch": false,
    "task": false,
    "skill": false
  }
}