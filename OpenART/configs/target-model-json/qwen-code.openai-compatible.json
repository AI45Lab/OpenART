{
  "modelProviders": {
    "openai": [
      {
        "id": "${model.name}",
        "name": "${model.name}",
        "baseUrl": "${model.base_url}",
        "description": "OpenART target model",
        "envKey": "${env_name.api_key}",
        "generationConfig": {
          "timeout": 600000
        }
      }
    ]
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "model": {
    "name": "${model.name}"
  }
}
