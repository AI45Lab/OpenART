{
  "$schema": "https://docs.openclaw.ai/schemas/openclaw.schema.json",
  "agents": {
    "defaults": {
      "workspace": "/workspace",
      "skipBootstrap": true,
      "model": {
        "primary": "openart/${model.name}",
        "fallbacks": []
      },
      "models": {
        "openart/${model.name}": {
          "alias": "${model.name}",
          "agentRuntime": {
            "id": "openclaw"
          }
        }
      },
      "thinkingDefault": "medium",
      "verboseDefault": "off",
      "timeoutSeconds": 600
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "openart": {
        "baseUrl": "${model.base_url}",
        "apiKey": "${env_ref.api_key}",
        "api": "openai-completions",
        "models": [
          {
            "id": "${model.name}",
            "name": "${model.name}",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "contextTokens": 96000,
            "maxTokens": 8192,
            "compat": {
              "requiresStringContent": true,
              "requiresAssistantAfterToolResult": true,
              "strictMessageKeys": false
            }
          }
        ]
      }
    }
  },
  "tools": {
    "profile": "coding",
    "sessions": {
      "visibility": "self"
    }
  }
}
