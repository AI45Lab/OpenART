# Target model used by model-backed target-agent runs.
TARGET_BASE_URL=https://api.example.com/v1
TARGET_MODEL=your-target-model
TARGET_API_KEY=your-target-key

# Judge model used when --eval-strategy llm or both is selected.
JUDGE_BASE_URL=${TARGET_BASE_URL}
JUDGE_MODEL=${TARGET_MODEL}
JUDGE_API_KEY=${TARGET_API_KEY}

# Attacker model used by OpenCode-compatible attacker presets.
ATTACK_BASE_URL=${TARGET_BASE_URL}
ATTACK_MODEL=${TARGET_MODEL}
ATTACK_API_KEY=${TARGET_API_KEY}

# Planner model used by python -m framework.planner.cli.
OPENART_PLANNER_BASE_URL=https://api.example.com/v1
OPENART_PLANNER_MODEL=your-planner-model
OPENART_PLANNER_API_KEY=your-planner-key
