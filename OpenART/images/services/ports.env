# Central port and image configuration for OpenART service compose files.
# Run compose with: docker compose --env-file ports.env -f docker-compose.yml ...

SERVICE_BIND_HOST=127.0.0.1

# DTAP services use host networking and read these role-specific ports directly.
FINANCE_WEB_PORT=23000
LEGAL_WEB_PORT=23100
GMAIL_SMTP_PORT=24000
GMAIL_AUTH_PORT=24001
GMAIL_PROXY_PORT=24002
GMAIL_UI_PORT=24003
GMAIL_FRONTEND_PORT=24004
SLACK_API_PORT=24500
SLACK_UI_PORT=24501
CALENDAR_API_PORT=24600
CALENDAR_UI_PORT=24601
ZOOM_API_PORT=24700
ZOOM_UI_PORT=24701
PAYPAL_PG_PORT=25000
PAYPAL_API_PORT=25001
PAYPAL_UI_PORT=25002
ATLASSIAN_DB_PORT=25100
ATLASSIAN_API_PORT=25101
ATLASSIAN_UI_PORT=25102
GITHUB_PG_PORT=25200
GITHUB_API_PORT=25201
GITHUB_UI_PORT=25202
GOOGLE_FORM_API_PORT=25300
GOOGLE_FORM_UI_PORT=25301
GOOGLEDOCS_PG_PORT=25400
GOOGLEDOCS_API_PORT=25401
GOOGLEDOCS_FRONTEND_PORT=25402
TELEGRAM_PG_PORT=25500
TELEGRAM_API_PORT=25501
WHATSAPP_PG_PORT=25600
WHATSAPP_API_PORT=25601
WHATSAPP_FRONTEND_PORT=25602
SNOWFLAKE_PG_PORT=25700
SNOWFLAKE_ADMIN_PORT=25701
DATABRICKS_PG_PORT=25800
DATABRICKS_ADMIN_PORT=25801
BIGQUERY_API_PORT=25900
BIGQUERY_GRPC_PORT=25901
BIGQUERY_PROJECT_ID=openart

# DTAP image defaults: public images from Docker Hub (decodingtrustagent org).
DTAP_FINANCE_IMAGE=decodingtrustagent/finance:latest
DTAP_LEGAL_IMAGE=decodingtrustagent/legal:latest
DTAP_MAILPIT_IMAGE=axllent/mailpit:latest
DTAP_GMAIL_SERVICE_IMAGE=decodingtrustagent/gmail:service-latest
DTAP_GMAIL_UI_IMAGE=decodingtrustagent/gmail:ui-latest
DTAP_SLACK_API_IMAGE=decodingtrustagent/slack:api-latest
DTAP_SLACK_UI_IMAGE=decodingtrustagent/slack:ui-latest
DTAP_CALENDAR_API_IMAGE=decodingtrustagent/google-calendar:api-latest
DTAP_CALENDAR_UI_IMAGE=decodingtrustagent/google-calendar:ui-latest
DTAP_ZOOM_API_IMAGE=decodingtrustagent/zoom:api-latest
DTAP_ZOOM_UI_IMAGE=decodingtrustagent/zoom:ui-latest
DTAP_POSTGRES16_IMAGE=postgres:16
DTAP_PAYPAL_API_IMAGE=decodingtrustagent/paypal:api-latest
DTAP_PAYPAL_UI_IMAGE=decodingtrustagent/paypal:ui-latest
DTAP_ATLASSIAN_API_IMAGE=decodingtrustagent/atlassian:api-latest
DTAP_ATLASSIAN_UI_IMAGE=decodingtrustagent/atlassian:ui-latest
DTAP_GITHUB_DB_IMAGE=decodingtrustagent/github:db-latest
DTAP_GITHUB_API_IMAGE=decodingtrustagent/github:api-latest
DTAP_GITHUB_UI_IMAGE=decodingtrustagent/github:ui-latest
DTAP_GOOGLE_FORM_API_IMAGE=decodingtrustagent/google-form:api-latest
DTAP_GOOGLE_FORM_UI_IMAGE=decodingtrustagent/google-form:ui-latest
DTAP_GOOGLEDOCS_DB_IMAGE=decodingtrustagent/google-docs:db-latest
DTAP_GOOGLEDOCS_API_IMAGE=decodingtrustagent/google-docs:api-latest
DTAP_GOOGLEDOCS_UI_IMAGE=decodingtrustagent/google-docs:ui-latest
DTAP_TELEGRAM_PG_IMAGE=decodingtrustagent/telegram:pg-latest
DTAP_TELEGRAM_API_IMAGE=decodingtrustagent/telegram:api-latest
DTAP_WHATSAPP_PG_IMAGE=decodingtrustagent/whatsapp:pg
DTAP_WHATSAPP_API_IMAGE=decodingtrustagent/whatsapp:api-latest
DTAP_WHATSAPP_UI_IMAGE=decodingtrustagent/whatsapp:ui-latest
DTAP_SNOWFLAKE_PG_IMAGE=decodingtrustagent/snowflake:latest
DTAP_SNOWFLAKE_ADMIN_IMAGE=decodingtrustagent/snowflake:admin
DTAP_DATABRICKS_PG_IMAGE=decodingtrustagent/databricks:latest
DTAP_DATABRICKS_ADMIN_IMAGE=decodingtrustagent/databricks:admin
DTAP_BIGQUERY_IMAGE=ghcr.io/goccy/bigquery-emulator:latest

# Standalone app/service ports.
MAILPIT_SMTP_PORT=26000
MAILPIT_UI_PORT=26001
GITEA_HTTP_PORT=26010
GITEA_SSH_PORT=26011
MATTERMOST_PORT=26020
BASEROW_PORT=26030
NOCODB_PORT=26040
OPENPROJECT_PORT=26050
NEXTCLOUD_PORT=26060
ONLYOFFICE_PORT=26061
MINIO_API_PORT=26070
MINIO_CONSOLE_PORT=26071
LOCALSTACK_EDGE_PORT=26080
GENERIC_BIGQUERY_API_PORT=26090
GENERIC_BIGQUERY_GRPC_PORT=26091
GENERIC_BIGQUERY_PROJECT_ID=openart
GOTENBERG_PORT=26100

# Non-DTAP credentials and local defaults.
PAYPAL_POSTGRES_USER=postgres
PAYPAL_POSTGRES_PASSWORD=postgres
PAYPAL_POSTGRES_DB=paypal
ATLASSIAN_POSTGRES_USER=postgres
ATLASSIAN_POSTGRES_PASSWORD=postgres
ATLASSIAN_POSTGRES_DB=atlassian
MATTERMOST_DB_USER=mattermost
MATTERMOST_DB_PASSWORD=openart
MATTERMOST_DB_NAME=mattermost
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=openart
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=openart
MINIO_ROOT_USER=openart
MINIO_ROOT_PASSWORD=openart-secret
LOCALSTACK_SERVICES=s3,sqs,dynamodb,lambda,sts
LOCALSTACK_DEBUG=0
OPENPROJECT_SECRET_KEY_BASE=openart-openproject-secret
