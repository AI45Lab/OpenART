FROM openart/opencode:latest

LABEL maintainer="OpenART Framework"
LABEL description="OpenART runner image with GitHub Copilot CLI installed"
LABEL version="1.0.0"

ARG COPILOT_CLI_VERSION=latest

RUN npm install -g n \
    && n 22 \
    && node --version \
    && npm --version \
    && npm install -g "@github/copilot@${COPILOT_CLI_VERSION}" \
    && command -v copilot \
    && copilot --version

WORKDIR /workspace

CMD ["/bin/bash"]
