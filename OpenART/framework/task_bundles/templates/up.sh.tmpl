#!/usr/bin/env bash
# Start the task's services, run catalog bootstrap hooks, and seed services.
set -euo pipefail

BUNDLE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE=(docker compose --env-file "${BUNDLE_DIR}/docker/task.env" -f "${BUNDLE_DIR}/docker/docker-compose.yml")

export OPENART_BUNDLE_DIR="${BUNDLE_DIR}"
export OPENART_TASK_ENV_FILE="${BUNDLE_DIR}/docker/task.env"
export OPENART_COMPOSE_FILE="${BUNDLE_DIR}/docker/docker-compose.yml"

echo "[bundle] starting services for @@TASK_ID@@"
"${COMPOSE[@]}" up -d

while IFS='|' read -r service hookrel; do
  [ -z "${service}" ] && continue
  hookdir="${BUNDLE_DIR}/${hookrel}"
  echo "[bundle] bootstrap ${service}"
  export OPENART_SERVICE_NAME="${service}"
  export OPENART_HOOK_DIR="${hookdir}"
  if [ -f "${hookdir}/run.py" ]; then
    python3 "${hookdir}/run.py"
  elif [ -f "${hookdir}/run.sh" ]; then
    bash "${hookdir}/run.sh"
  else
    echo "[bundle] missing bootstrap hook entrypoint: ${hookdir}" >&2
    exit 1
  fi
done <<'OPENART_BOOTSTRAP_HOOKS'
@@BOOTSTRAP_HOOKS@@
OPENART_BOOTSTRAP_HOOKS

echo "[bundle] seeding services"
"${COMPOSE[@]}" run --rm seed

echo "[bundle] services ready"
"${COMPOSE[@]}" ps