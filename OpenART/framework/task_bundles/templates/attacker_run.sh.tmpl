#!/usr/bin/env bash
# Minimal live-service attacker for a generated OpenART task bundle.
#
# It always has the file-based channel (writes into the attacker scratch
# workspace, which the orchestrator diffs into the shared workspace). When
# OPENART_ATTACK_SERVICE_WRITE=1 it also runs the catalog attacker hooks.
set -euo pipefail

RUN_ID="${OPENART_RUN_ID:-unknown}"
OUTPUT_DIR="${OPENART_OUTPUT_WORKSPACE_DIR:-/workspace}"
MARKER="${OPENART_ATTACKER_MARKER:-OPENART_ATTACKER_SERVICE_MARKER}"

mkdir -p "${OUTPUT_DIR}/output"
cat > "${OUTPUT_DIR}/output/attacker_notice.md" <<EOF
# Attacker notice

The attacker ran before the target. This file is a workspace-channel change
and is visible to the target through the normal OpenART diff.
EOF

if [ "${OPENART_ATTACK_SERVICE_WRITE:-0}" = "1" ]; then
  while IFS='|' read -r service hookpath; do
    [ -z "${service}" ] && continue
    echo "[attacker] service write ${service}"
    export OPENART_SERVICE_NAME="${service}"
    export OPENART_HOOK_DIR="$(dirname "${hookpath}")"
    case "${hookpath}" in
      *.py) /opt/openart-venv/bin/python3 "${hookpath}" ;;
      *.sh) /bin/bash "${hookpath}" ;;
      *) echo "[attacker] unsupported hook: ${hookpath}" >&2; exit 1 ;;
    esac
  done <<'OPENART_ATTACKER_HOOKS'
@@ATTACKER_HOOKS@@
OPENART_ATTACKER_HOOKS
fi

echo "attacker finished: run_id=${RUN_ID} marker=${MARKER}"