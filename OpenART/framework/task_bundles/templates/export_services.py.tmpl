#!/usr/bin/env python3
"""Export live service state into the workspace roots the evaluator reads."""

from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import sys


SERVICES = @@SERVICES_JSON@@
PUBLIC_ROOTS = @@PUBLIC_ROOTS_JSON@@
EXPORT_HOOKS = @@EXPORT_HOOKS_JSON@@
WORKSPACE = Path(os.environ.get("OPENART_WORKSPACE", "/workspace"))
TASK_ROOT = Path(__file__).resolve().parents[1]


def _hook_command(path: str) -> list[str]:
    suffix = Path(path).suffix.lower()
    if suffix == ".py":
        return [sys.executable, path]
    if suffix == ".sh":
        return ["/bin/bash", path]
    raise RuntimeError(f"unsupported export hook: {path}")


def _run_hook(service: str, path: str) -> dict:
    hook_dir = Path(path).resolve().parent
    env = dict(os.environ)
    env.update(
        {
            "OPENART_SERVICE_NAME": service,
            "OPENART_WORKSPACE": str(WORKSPACE),
            "OPENART_PUBLIC_ROOTS_JSON": json.dumps(PUBLIC_ROOTS),
            "OPENART_TASK_ROOT": str(TASK_ROOT),
            "OPENART_HOOK_DIR": str(hook_dir),
        }
    )
    proc = subprocess.run(
        _hook_command(path),
        cwd=str(hook_dir),
        env=env,
        capture_output=True,
        text=True,
        timeout=240,
    )
    output = (proc.stdout or "").strip()
    error = (proc.stderr or "").strip()
    if proc.returncode != 0:
        raise RuntimeError(f"{service} export hook failed: {error or output or 'no output'}")
    if not output:
        return {}
    try:
        return json.loads(output)
    except ValueError:
        return {"stdout": output}


def main() -> int:
    summary: dict[str, object] = {"services": SERVICES, "public_roots": PUBLIC_ROOTS}
    errors = 0
    for service, path in EXPORT_HOOKS.items():
        try:
            result = _run_hook(service, path)
        except Exception as exc:  # noqa: BLE001 - report every hook failure
            result = {"errors": [str(exc)]}
        summary[service] = result
        hook_errors = result.get("errors") if isinstance(result, dict) else None
        if isinstance(hook_errors, list):
            errors += len(hook_errors)
    try:
        target = WORKSPACE / ".openart" / "service_export.json"
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
    except OSError:
        pass
    print(json.dumps(summary, indent=2))
    return 1 if errors else 0


if __name__ == "__main__":
    raise SystemExit(main())