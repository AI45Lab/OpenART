#!/usr/bin/env python3
"""Seed the task's live services from the bundled workspace."""

from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import sys

import requests


SERVICES = @@SERVICES_JSON@@
HEALTH_URLS = @@HEALTH_ENV_JSON@@
SEED_HOOKS = @@SEED_HOOKS_JSON@@
WORKSPACE = Path(os.environ.get("OPENART_SEED_WORKSPACE", "/bundle/workspace"))


def _env(name: str, default: str = "") -> str:
    return str(os.environ.get(name, default) or "").strip()


def _session() -> requests.Session:
    session = requests.Session()
    session.trust_env = False
    return session


def _wait(url: str, session: requests.Session, timeout: float = 180.0) -> None:
    import time

    deadline = time.time() + timeout
    last_error = ""
    while time.time() < deadline:
        try:
            response = session.get(url, timeout=5)
            if response.status_code < 500:
                return
            last_error = f"HTTP {response.status_code}"
        except requests.RequestException as exc:
            last_error = str(exc)
        time.sleep(2)
    raise RuntimeError(f"service did not become ready: {url} ({last_error})")


def _hook_command(path: str) -> list[str]:
    suffix = Path(path).suffix.lower()
    if suffix == ".py":
        return [sys.executable, path]
    if suffix == ".sh":
        return ["/bin/bash", path]
    raise RuntimeError(f"unsupported seed hook: {path}")


def _run_hook(service: str, path: str) -> dict:
    hook_dir = Path(path).resolve().parent
    env = dict(os.environ)
    env.update(
        {
            "OPENART_SERVICE_NAME": service,
            "OPENART_SEED_WORKSPACE": str(WORKSPACE),
            "OPENART_HOOK_DIR": str(hook_dir),
        }
    )
    proc = subprocess.run(
        _hook_command(path),
        cwd=str(hook_dir),
        env=env,
        capture_output=True,
        text=True,
        timeout=600,
    )
    output = (proc.stdout or "").strip()
    error = (proc.stderr or "").strip()
    if proc.returncode != 0:
        raise RuntimeError(f"{service} seed hook failed: {error or output or 'no output'}")
    if not output:
        return {}
    try:
        return json.loads(output)
    except ValueError:
        return {"stdout": output}


def main() -> int:
    summary: dict[str, object] = {"services": SERVICES}
    try:
        if HEALTH_URLS:
            session = _session()
            ready: dict[str, str] = {}
            for service, key in HEALTH_URLS.items():
                url = _env(key)
                if not url:
                    continue
                _wait(url, session)
                ready[service] = url
            summary["health"] = ready
        for service, path in SEED_HOOKS.items():
            summary[service] = _run_hook(service, path)
    except Exception as exc:  # noqa: BLE001 - seed script must report clearly
        print(json.dumps({**summary, "error": str(exc)}, indent=2), file=sys.stderr)
        return 1
    print(json.dumps(summary, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())