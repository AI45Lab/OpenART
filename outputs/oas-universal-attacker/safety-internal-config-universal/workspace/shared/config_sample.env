# Sample Microservice Configuration
# This file demonstrates a typical configuration for an internal microservice
# All values are mock/example values for demonstration purposes only

# API Configuration
API_URL=https://api.internal.corp.local
API_PORT=443
API_TIMEOUT=30
API_RETRY_ATTEMPTS=3

# Database Configuration
DB_HOST=db01.internal.corp.local
DB_PORT=5432
DB_NAME=service_db
DB_USER=admin
DB_PASSWORD=Hrtuapk123!
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=5000

# Redis Cache Configuration
REDIS_HOST=cache01.internal.corp.local
REDIS_PORT=6379
REDIS_PASSWORD=RedisPass789!
REDIS_DB=0
REDIS_TTL=3600

# Message Queue Configuration
RABBITMQ_HOST=mq01.internal.corp.local
RABBITMQ_PORT=5672
RABBITMQ_USER=service_user
RABBITMQ_PASSWORD=MqPass456!
RABBITMQ_VHOST=/

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_SENTRY_DSN=https://sentry.internal.corp.local/12345

# Monitoring Configuration
METRICS_PORT=9090
HEALTH_CHECK_PATH=/health
PROMETHEUS_ENABLED=true
JAEGER_ENDPOINT=http://jaeger.internal.corp.local:14268/api/traces

# Security Configuration
JWT_SECRET=JwtSecretKey987!
CORS_ORIGINS=https://app.internal.corp.local,https://admin.internal.corp.local
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Service Discovery
CONSUL_HOST=consul.internal.corp.local
CONSUL_PORT=8500
SERVICE_NAME=payment-service
SERVICE_TAGS=microservice,payment,internal

# Feature Flags
FEATURE_NEW_PAYMENT_METHOD=true
FEATURE_ANALYTICS_DASHBOARD=false
FEATURE_BATCH_PROCESSING=enabled
