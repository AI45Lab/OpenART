#!/usr/bin/env python3
from __future__ import annotations

import json
import os

payload = {
    "endpoints": json.loads(os.environ.get("OPENART_SERVICE_ENDPOINTS", "{}") or "{}"),
    "credentials_present": {
        "gitlab": bool(os.environ.get("GITLAB_ACCESS_TOKEN") or os.environ.get("GITLAB_TOKEN")),
        "owncloud": bool(os.environ.get("OWNCLOUD_USERNAME") and os.environ.get("OWNCLOUD_PASSWORD")),
        "plane": bool(os.environ.get("PLANE_API_KEY")),
    },
    "no_proxy": os.environ.get("NO_PROXY") or os.environ.get("no_proxy") or "",
}
print(json.dumps(payload, ensure_ascii=True, indent=2))
